{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "outer-minimal",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-06",
  "compatibility_flags": ["nodejs_compat"],
  // Seeds a single admin account on the first request after deploy, signing in via
  // email OTP only. Remove (or leave empty) to skip seeding.
  "vars": {
    "ADMIN_EMAIL": "admin@example.com",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTER_DO",
        "class_name": "OuterDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OuterDO"],
    },
  ],
  // Bytes for `.files()` uploads. Wrangler will automatically provision this bucket on first deploy.
  "r2_buckets": [
    {
      "binding": "OUTER_FILES",
      "bucket_name": "outer-files",
    },
  ],
  // Backs `context.kv`. Wrangler will automatically provision this namespace on deploy.
  // `wrangler dev` simulates KV locally, so no setup is required.
  "kv_namespaces": [
    {
      "binding": "OUTER_KV",
      "id": "0c2ccaa6d45148358509a1c47f8d3995",
    },
  ],
}
